{
  "name": "hunter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --schema public,app --level warning",
    "db:coverage": "scripts/db-coverage.sh",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "test:coverage": "vitest run --project unit --coverage --coverage.include='src/lib/**/*.ts' --coverage.exclude='src/lib/supabase/**' --coverage.exclude='src/lib/env.ts' --coverage.exclude='src/lib/auth/**' --coverage.exclude='src/lib/venue/place-access.ts' --coverage.exclude='src/lib/venue/qr-credentials.ts'",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test",
    "db:grant-staff": "scripts/grant-place-access.sh",
    "db:mutation": "python3 scripts/db-mutation.py"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "leaflet": "1.9.4",
    "lucide-react": "^1.71.0",
    "next": "^16.4.5",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "1.9.21",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "supabase": "^2.40.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
