# Copiar a .env.local. Valores de Supabase local: `npx supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_ORIGIN=http://127.0.0.1:3000

# Indexación: mantener ambos valores en pruebas. Solo activar en el origen principal HTTPS.
HUNTER_ENV=preview
HUNTER_INDEXING_ENABLED=false
